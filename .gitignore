!runtime/logs/
!runtime/logs/.gitkeep
!runtime/outputs/
!runtime/outputs/.gitkeep
*.db
*.sqlite
*.sqlite3

# OpenCompass run artifacts: 它会在 cwd 下生成临时 params/中间产物
tmp/
core/tmp/
icl_inference_output/
.cache/

# Build outputs
dist/
build/
frontend/dist/
*.exe
*.out

# Logs
*.log
logs/

# IDE and OS
.DS_Store
.idea/
.vscode/
.cursor/
*.swp
