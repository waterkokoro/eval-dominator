# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local config and secrets
.env
.env.*
!*.example
backend/config/config.yaml
core/config/config.yaml

# Runtime outputs / state（DB、产物、日志一律本地化，永远不要 commit）
runtime/
